# ─────────────────────────────────────────────────────────────
# GlobalPoolStore environment configuration
# Copy to .env and fill in the [Insert ... Here] placeholders.
# ─────────────────────────────────────────────────────────────

# Database (docker-compose maps Postgres to port 5433)
DATABASE_URL="postgresql://globalpool:globalpool@localhost:5433/globalpool?schema=public"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"          # https://[Insert Domain Name Here]
NEXT_PUBLIC_SITE_NAME="GlobalPoolStore"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"       # [Insert Support Email Here]
NEXT_PUBLIC_WHATSAPP="[Insert International WhatsApp Number Here]"
NEXT_PUBLIC_TELEGRAM="[Insert Telegram Handle Here]"
NEXT_PUBLIC_REFERRAL_PERCENT="5"                       # [Insert Referral Commission % Here]

# Security: generate with `openssl rand -base64 32`
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
VAULT_KEY="change-me-32-byte-base64-key-for-aes-gcm-encryption"

# Google OAuth (optional): https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Live FX rates (optional, falls back to static rates): https://openexchangerates.org
OPENEXCHANGERATES_APP_ID=""

# ─── Payment gateways: deferred ───
# [Insert Payment Gateway API Keys / Details Here]
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# COINBASE_COMMERCE_API_KEY=""
# BINANCE_PAY_API_KEY=""
# NOWPAYMENTS_API_KEY=""
